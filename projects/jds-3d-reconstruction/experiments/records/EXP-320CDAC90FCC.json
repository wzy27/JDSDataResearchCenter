  "project_id": "jds-3d-reconstruction",
  "title": "E-alpha 循环消融：互导是否稳健优于单向引导",
  "type": "ablation",
  "status": "planned",
  "objective": "在同一批场景上对比仅表示 A、仅表示 B、单向 A→B、双向 A↔B 四种配置，检验假设 H1：是否存在互导劣于单向引导的情形。",
  "protocol": {
    "scope": "只做四路对比，不引入任何新方法。这是论点的根基判据：若互导稳健更优，H1 为假，方向应放弃。",
    "success_criteria": [
      "四种配置在相同场景、相同迭代预算下完成训练",
      "几何指标 Chamfer distance 与 F-score、渲染指标 PSNR/SSIM/LPIPS 齐全",
      "至少一个场景上双向配置不优于单向配置，且差异超出种子波动"
    ],
    "failure_criteria": [
      "双向配置在全部场景上稳健优于单向，且差异均超出种子波动 —— H1 为假",
      "四种配置无法在相同预算下公平对比",
      "GS-Octree 代码无法复现原论文数值"
    ],
    "expected_outputs": [
      "四路对比表（几何 + 渲染）",
      "逐场景差异与种子波动的置信区间",
      "失效场景的定性渲染与网格对比"
    ]
  },
