  "project_id": "jds-3d-reconstruction",
  "title": "共享环境光与空间光照残差的统一重打光",
  "kind": "hypothesis",
  "status": "challenged",
  "statement": "共享环境光参数提供跨组件的全局一致性，空间分区光照残差与材质先验补充建筑阴影和局部光源，可在不重建几何的情况下提升编辑后重打光真实性。",
  "motivation": "单一全局光照无法表达街区阴影，完全独立的组件光照又容易产生曝光和色调不一致。",
  "assumptions": [
    "合成数据能够提供可控的光照和阴影真值。"
  ],
  "alternatives": [
    "仅学习每个组件的外观变换。"
  ],
  "validation": {
    "success_criteria": [
      "在 CARLA 跨光照测试上优于仅全局环境光和仅外观变换基线，并保持跨组件曝光一致。"
    ],
    "failure_signals": [
      "空间残差吸收材质/几何，或编辑后阴影位置与遮挡关系不一致。"
    ],
