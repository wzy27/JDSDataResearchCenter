{
  "schema_version": "experiment-watchdog/v1",
  "name": "replace-with-unique-job-name",
  "cwd": "/absolute/path/to/project",
  "command": ["python", "train.py", "--config", "/absolute/path/to/config.json"],
  "env": {},
  "resource": {
    "provider": "auto",
    "poll_seconds": 5,
    "stable_seconds": 30,
    "wait_timeout_seconds": 86400,
    "reminder_seconds": [7200, 21600]
  },
  "progress": {
    "poll_seconds": 2,
    "startup_timeout_seconds": 900,
    "no_progress_timeout_seconds": 900,
    "task_timeout_seconds": 86400,
    "terminate_grace_seconds": 30,
    "start_patterns": [],
    "heartbeat_globs": [],
    "fatal_patterns": [
      "Traceback \\(most recent call last\\)",
      "(?:Value|Runtime|Assertion|Memory)Error:",
      "out of memory",
      "ChildFailedError",
      "HCCL.*(?:error|failed)",
      "NCCL.*(?:error|failed)",
      "core dumped"
    ]
  },
  "outputs": {
    "required": [
      {"glob": "outputs/COMPLETE.json", "min_count": 1, "min_size_bytes": 2}
    ]
  }
}
