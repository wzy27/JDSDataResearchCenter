{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchcenter.local/schemas/experiment-record.schema.json",
  "title": "ResearchCenter experiment record",
  "type": "object",
  "required": [
    "schema_version", "experiment_id", "project_id", "title", "type", "status", "objective",
    "protocol", "traceability", "execution", "code", "data", "environment", "resources",
    "blockers", "preflight", "results", "events", "provenance", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9A-F]{12}$"},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["contract-test", "preflight", "smoke-test", "training", "evaluation", "benchmark", "ablation", "data-generation", "analysis"]},
    "status": {"enum": ["planned", "blocked", "ready", "queued", "running", "verifying", "complete", "failed", "stopped", "cancelled"]},
    "objective": {"type": "string", "minLength": 1},
    "protocol": {"type": "object"},
    "traceability": {"type": "object"},
    "execution": {"type": "object"},
    "code": {"type": "object"},
    "data": {"type": "object"},
    "environment": {"type": "object"},
    "resources": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "preflight": {"type": "object"},
    "results": {"type": "object"},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "provenance": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
